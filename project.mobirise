{
  "settings": {
    "currentPage": "RU.html",
    "theme": {
      "name": "mobirise5",
      "title": "Mobirise 5",
      "styling": {
        "primaryColor": "#4d6d9a",
        "secondaryColor": "#edb5bf",
        "successColor": "#40b0bf",
        "infoColor": "#47b5ed",
        "warningColor": "#FFE161",
        "dangerColor": "#ff9966",
        "mainFont": "Jost",
        "display1Font": "Jost",
        "display1Size": 4.6,
        "display2Font": "Jost",
        "display2Size": 3,
        "display5Font": "Jost",
        "display5Size": 2,
        "display7Font": "Jost",
        "display7Size": 1.2,
        "display4Font": "Jost",
        "display4Size": 1.1,
        "isRoundedButtons": false,
        "isGhostButtonBorder": false,
        "underlinedLinks": false,
        "isAnimatedOnScroll": false,
        "isScrollToTopButton": false
      },
      "titlePreset": "Photo",
      "nameSelectPreset": "photo",
      "presetSourceTheme": "mobirise5",
      "additionalSetColors": [
        "#0b3b91",
        "#082250",
        "#0b60fa",
        "#4d6d9a",
        "#364e6f"
      ]
    },
    "path": "@PROJECT_PATH@",
    "name": "The World Order Matrix",
    "versionFirst": "6.0.6",
    "siteFonts": [
      {
        "css": "'Bellota Text', display",
        "name": "Bellota Text",
        "url": "https://fonts.googleapis.com/css?family=Bellota+Text:300,300i,400,400i,700,700i"
      },
      {
        "css": "'Jost', sans-serif",
        "name": "Jost",
        "url": "https://fonts.googleapis.com/css?family=Jost:100,200,300,400,500,600,700,800,900,100i,200i,300i,400i,500i,600i,700i,800i,900i"
      }
    ],
    "imageResize": true,
    "favicon": false,
    "mbrsiteDomain": "theworldordermatrix",
    "usedWebp": false,
    "robotsSwitcher": false,
    "sitemapSwitcher": false,
    "sitemapSwitcherAuto": false,
    "siteUrl": false,
    "cookiesAlert": false,
    "gdpr": false,
    "uniqCompNum": 99,
    "versionPublish": "6.0.6",
    "screenshot": "screenshot.png"
  },
  "pages": {
    "index.html": {
      "settings": {
        "main": true,
        "title": "The World Order Matrix",
        "meta_descr": "The World Order Matrix",
        "header_custom": "",
        "footer_custom": "",
        "html_before": ""
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@sticky)": {
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "& when (@sticky)": {
              "z-index": "1000",
              "width": "100%",
              "& when not (@transparent)": {
                "position": "relative",
                "min-height": "60px"
              },
              "nav.navbar": {
                "position": "fixed"
              }
            },
            ".dropdown-item:before": {
              "font-family": "Moririse2 !important",
              "content": "\"\\e966\"",
              "display": "inline-block",
              "width": "0",
              "position": "absolute",
              "left": "1rem",
              "top": "0.5rem",
              "margin-right": "0.5rem",
              "line-height": "1",
              "font-size": "inherit",
              "vertical-align": "middle",
              "text-align": "center",
              "overflow": "hidden",
              "transform": "scale(0, 1)",
              "transition": "all 0.25s ease-in-out"
            },
            ".dropdown-menu": {
              "padding": "0",
              "border-radius": "4px",
              "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)"
            },
            ".dropdown-item": {
              "border-bottom": "1px solid #e6e6e6",
              "&:hover, &:focus": {
                "background": "@primaryColor !important",
                "color": "white !important"
              },
              "&:hover span": {
                "color": "white"
              },
              "&:first-child": {
                "border-top-left-radius": "4px",
                "border-top-right-radius": "4px"
              },
              "&:last-child": {
                "border-bottom": "none",
                "border-bottom-left-radius": "4px",
                "border-bottom-right-radius": "4px"
              }
            },
            ".nav-dropdown .link": {
              "padding": "0 0.3em !important",
              "margin": "0.667em 1em !important"
            },
            ".nav-dropdown .link.dropdown-toggle::after": {
              "margin-left": "0.5rem",
              "margin-top": "0.2rem"
            },
            ".nav-link": {
              "position": "relative"
            },
            ".container": {
              "display": "flex",
              "margin": "auto",
              "& when not (@collapsed)": {
                "@media (min-width: 992px)": {
                  "flex-wrap": "nowrap"
                }
              }
            },
            ".iconfont-wrapper": {
              "color": "@iconsColor !important",
              "font-size": "1.5rem",
              "padding-right": "0.5rem"
            },
            ".navbar-caption": {},
            ".navbar-nav": {},
            ".dropdown-menu, .navbar.opened": {
              "background": "@menuBgColor !important"
            },
            ".nav-item:focus, .nav-link:focus": {
              "outline": "none"
            },
            ".dropdown .dropdown-menu .dropdown-item": {
              "width": "auto",
              "transition": "all 0.25s ease-in-out",
              "&::after": {
                "right": "0.5rem"
              },
              ".mbr-iconfont": {
                "margin-right": "0.5rem",
                "vertical-align": "sub",
                "&:before": {
                  "display": "inline-block",
                  "transform": "scale(1, 1)",
                  "transition": "all 0.25s ease-in-out"
                }
              }
            },
            ".collapsed": {
              ".dropdown-menu .dropdown-item:before": {
                "display": "none"
              },
              ".dropdown .dropdown-menu .dropdown-item": {
                "padding": "0.235em 1.5em 0.235em 1.5em !important",
                "transition": "none",
                "margin": "0 !important"
              }
            },
            ".navbar": {
              "min-height": "70px",
              "transition": "all 0.3s",
              "border-bottom": "1px solid transparent",
              "&:not(.navbar-short)": {},
              "& when not (@transparent)": {
                "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)",
                "background": "@menuBgColor"
              },
              "& when (@transparent)": {
                "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity)"
              },
              "&.opened": {
                "transition": "all 0.3s"
              },
              ".dropdown-item": {
                "padding": "0.5rem 1.8rem"
              },
              ".navbar-logo img": {
                "width": "auto"
              },
              ".navbar-collapse": {
                "justify-content": "flex-end",
                "z-index": "1"
              },
              "&.collapsed": {
                "justify-content": "center",
                ".nav-item .nav-link::before": {
                  "display": "none"
                },
                "&.opened": {
                  ".dropdown-menu": {
                    "top": "0"
                  },
                  "@media (min-width: 992px)": {
                    "&:not(.navbar-short) .navbar-collapse when (@showLogo)": {
                      "max-height": "~\"calc(98.5vh - @{logoSize}rem)\""
                    }
                  }
                },
                ".dropdown-menu": {
                  ".dropdown-submenu": {
                    "left": "0 !important"
                  },
                  ".dropdown-item:after": {
                    "right": "auto"
                  },
                  ".dropdown-toggle[data-toggle=\"dropdown-submenu\"]:after": {
                    "margin-left": "0.5rem",
                    "margin-top": "0.2rem",
                    "border-top": "0.35em solid",
                    "border-right": "0.35em solid transparent",
                    "border-left": "0.35em solid transparent",
                    "border-bottom": "0",
                    "top": "41%"
                  }
                },
                "ul.navbar-nav": {
                  "li": {
                    "margin": "auto"
                  }
                },
                ".dropdown-menu .dropdown-item": {
                  "padding": "0.25rem 1.5rem",
                  "text-align": "center"
                },
                ".icons-menu": {
                  "padding-left": "0",
                  "padding-right": "0",
                  "padding-top": "0.5rem",
                  "padding-bottom": "0.5rem"
                }
              },
              "@media (max-width: 991px)": {
                ".nav-item .nav-link::before": {
                  "display": "none"
                },
                "&.opened": {
                  ".dropdown-menu": {
                    "top": "0"
                  }
                },
                ".dropdown-menu": {
                  ".dropdown-submenu": {
                    "left": "0 !important"
                  },
                  ".dropdown-item:after": {
                    "right": "auto"
                  },
                  ".dropdown-toggle[data-toggle=\"dropdown-submenu\"]:after": {
                    "margin-left": "0.5rem",
                    "margin-top": "0.2rem",
                    "border-top": "0.35em solid",
                    "border-right": "0.35em solid transparent",
                    "border-left": "0.35em solid transparent",
                    "border-bottom": "0",
                    "top": "40%"
                  }
                },
                ".navbar-logo": {
                  "img": {
                    "height": "3rem !important"
                  }
                },
                "ul.navbar-nav": {
                  "li": {
                    "margin": "auto"
                  }
                },
                ".dropdown-menu .dropdown-item": {
                  "padding": "0.25rem 1.5rem !important",
                  "text-align": "center"
                },
                ".navbar-brand": {
                  "flex-shrink": "initial",
                  "flex-basis": "auto",
                  "word-break": "break-word",
                  "padding-right": "2rem",
                  "@media (max-width: 767px)": {
                    "width": "~\"calc(100% - 31px)\""
                  }
                },
                ".navbar-toggler": {
                  "flex-basis": "auto"
                },
                ".icons-menu": {
                  "padding-left": "0",
                  "padding-top": "0.5rem",
                  "padding-bottom": "0.5rem"
                }
              },
              "&.navbar-short": {
                "min-height": "60px",
                ".navbar-logo": {
                  "img": {
                    "height": "2.5rem !important"
                  }
                },
                ".navbar-brand": {
                  "min-height": "60px",
                  "padding": "0"
                }
              }
            },
            ".navbar-brand": {
              "min-height": "70px",
              "flex-shrink": "0",
              "align-items": "center",
              "margin-right": "0",
              "padding": "10px 0",
              "transition": "all 0.3s",
              "word-break": "break-word",
              "z-index": "1",
              ".navbar-caption": {
                "line-height": "inherit !important"
              },
              ".navbar-logo a": {
                "outline": "none"
              }
            },
            ".dropdown-item.active, .dropdown-item:active": {
              "background-color": "transparent"
            },
            ".navbar-expand-lg .navbar-nav .nav-link": {
              "padding": "0"
            },
            ".nav-dropdown .link.dropdown-toggle": {
              "margin-right": "1.667em",
              "&[aria-expanded=\"true\"]": {
                "margin-right": "0",
                "padding": "0.667em 1.667em"
              }
            },
            ".navbar.navbar-expand-lg .dropdown": {
              ".dropdown-menu": {
                "background": "@menuBgColor",
                ".dropdown-submenu": {
                  "margin": "0",
                  "left": "100%"
                }
              }
            },
            ".navbar .dropdown.open > .dropdown-menu": {
              "display": "block"
            },
            "ul.navbar-nav": {
              "flex-wrap": "wrap"
            },
            ".navbar-buttons": {
              "text-align": "center",
              "min-width": "170px"
            },
            "button.navbar-toggler": {
              "outline": "none",
              "width": "31px",
              "height": "20px",
              "cursor": "pointer",
              "transition": "all 0.2s",
              "position": "relative",
              "align-self": "center",
              ".hamburger span": {
                "position": "absolute",
                "right": "0",
                "width": "30px",
                "height": "2px",
                "border-right": "5px",
                "background-color": "@hamburgerColor",
                "&:nth-child(1)": {
                  "top": "0",
                  "transition": "all 0.2s"
                },
                "&:nth-child(2)": {
                  "top": "8px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(3)": {
                  "top": "8px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(4)": {
                  "top": "16px",
                  "transition": "all 0.2s"
                }
              }
            },
            "nav.opened .hamburger span": {
              "&:nth-child(1)": {
                "top": "8px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              },
              "&:nth-child(2)": {
                "transform": "rotate(45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(3)": {
                "transform": "rotate(-45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(4)": {
                "top": "8px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              }
            },
            ".navbar-dropdown": {
              "padding": "0 1rem",
              "& when (@sticky)": {
                "position": "fixed"
              }
            },
            "a.nav-link": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center"
            },
            ".icons-menu": {
              "flex-wrap": "nowrap",
              "display": "flex",
              "justify-content": "center",
              "padding-left": "1rem",
              "padding-right": "1rem",
              "padding-top": "0.3rem",
              "text-align": "center"
            },
            "@media screen and (~'-ms-high-contrast: active'), (~'-ms-high-contrast: none')": {
              ".navbar": {
                "height": "70px",
                "&.opened": {
                  "height": "auto"
                }
              },
              ".nav-item .nav-link:hover::before": {
                "width": "175%",
                "max-width": "calc(100% ~\"+\" 2rem)",
                "left": "-1rem"
              }
            }
          },
          "_name": "menu1",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu1\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\">\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"3\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\" checked>\n        <input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\">\n        <select title=\"Amount\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#000000\" condition=\"showIcons\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\">\n        <header>Styles</header>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"transparent\">\n        <input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#4d6d9a\">\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#232323\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                     'navbar-expand-lg':!collapsed,\n                     'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n            <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"https://mobiri.se\">\n                        <img src=\"../_images/logo.png\" alt=\"Mobirise Website Builder\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-white\" data-app-selector=\".navbar-caption\" href=\"index.html#top\" data-app-placeholder=\"Type Text\">AXICORR</a></span>\n            </div>\n            <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showIcons || showButtons\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\"><a class=\"nav-link link text-white text-primary\" href=\"index.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">EN</a></li>\n                    <li class=\"nav-item\"><a class=\"nav-link link text-white\" href=\"UA.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">UA</a></li>\n                    <li class=\"nav-item\"><a class=\"nav-link link text-white\" href=\"RU.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">RU</a>\n                    </li></ul>\n                <div class=\"icons-menu\" mbr-if=\"showIcons\">\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-facebook socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 1\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-twitter socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 2\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-instagram socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 3\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-linkedin socicon\"></span>\n                    </a>\n                </div>\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\">\n                    <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                        Download Now</a>\n                </div>\n            </div>\n        </div>\n    </nav>\n</section>",
          "_cid": "v0JEMumWWB",
          "_anchor": "menu1-2h",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".social-row": {
              ".soc-item": {
                "display": "inline-block",
                "text-align": "center",
                "margin-bottom": "1rem",
                "margin-right": ".7rem",
                ".mbr-iconfont": {
                  "font-size": "32px",
                  "border-radius": "50%",
                  "padding": "0.6rem",
                  "border": "2px solid @socialIconColor",
                  "transition": "all 0.3s",
                  "color": "@socialIconColor",
                  "&:hover": {
                    "background-color": "@socialIconColor",
                    "color": "contrast(@socialIconColor)"
                  }
                }
              }
            }
          },
          "_name": "header13",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header13\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n\n        <input type=\"range\" inline name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"10\" step=\"1\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value>Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\">\n        <input type=\"range\" name=\"socialCount\" title=\"Count\" min=\"1\" max=\"5\" step=\"1\" value=\"3\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Color\" name=\"socialIconColor\" value=\"#232323\" condition=\"showSocial\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/mbr-1-1920x1280.jpg\" parallax selected>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background13.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#bed3f9\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"align-center\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row {{contentAlign}}\">\n            <div class=\"col-12 col-lg-{{textWidth}}\">\n                <h1 class=\"mbr-section-title mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>A HUMAN against EVOLUTION</b></h1>\n                <h2 class=\"mbr-section-subtitle mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-2\" mbr-if=\"showSubitle\">the 2025th attempt</h2>\n                <p class=\"mbr-text mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn, .social-row\"><br>ONLY SHEEP NEED A SHEPHERD. A PERSON NEEDS A COURSE.</p>\n                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn mt-3\" mbr-if=\"showButtons\"><a class=\"btn btn-primary\" href=\"UA.html\" data-app-placeholder=\"Type Text\">UA</a> <a class=\"btn btn-primary\" href=\"mailto:axicorrman@gmail.com\" data-app-placeholder=\"Type Text\">MAIL</a> <a class=\"btn btn-primary\" href=\"RU.html\" data-app-placeholder=\"Type Text\">RU</a></div>\n                <div class=\"social-row display-7 mt-5\" mbr-if=\"showSocial\">\n                    <div class=\"soc-item\">\n                        <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont socicon socicon-facebook\"></span>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"socialCount>1\">\n                        <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont socicon socicon-twitter\"></span>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"socialCount>2\">\n                        <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"socialCount>3\">\n                        <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont socicon socicon-youtube\"></span>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"socialCount>4\">\n                        <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont socicon socicon-telegram\"></span>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uQtmGrVMUe",
          "_anchor": "header13-0",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            ".line": {
              "background-color": "@lineColor",
              "align": "center",
              "height": "2px",
              "margin": "0 auto"
            },
            ".mbr-text": {
              "color": "#364e6f"
            }
          },
          "_name": "content6",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content6\" group=\"Content\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"10\" step=\"1\">\n        \n        <input type=\"color\" name=\"lineColor\" title=\"Color\" value=\"#364e6f\">\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#ffffff\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-md-12 col-lg-{{textWidth}}\">\n                <hr class=\"line\">\n                <p class=\"mbr-text align-center mbr-fonts-style my-4\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\"><b>UKRAINE is capable of everything, except the main thing – it is not capable of EVOLVING. \n</b><br>The import of ideological raw materials in it is 100%, none of which has ever been checked for Fraud by anyone. That is why the “capital” of Ukrainians is always abroad. Nevertheless, everything that is happening to us now is no longer a story about Ukraine. This is a story about the World Order, which has deceived everyone for so long that, in the end, it deceived itself.<br></p>\n                <hr class=\"line\">\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v0FqPKQq1c",
          "_anchor": "content6-2e",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor"
          },
          "_name": "content5",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content5\" group=\"Content\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"10\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#ffffff\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-md-12 col-lg-{{textWidth}}\">\n                <h3 class=\"mbr-section-title mbr-fonts-style mb-4\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\">\n                    <b>Article Title</b>\n                </h3>\n                <h4 class=\"mbr-section-subtitle mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\">\n                    Enter your subtitle here\n                </h4>\n                <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\"><b>MAXIMUM RESULT by MINIMUM EFFORT: from a Thief to God – everyone lives by this formula because it is the FORMULA OF EVOLUTION. </b>The only difference is that the Pre-Intellectual World lives for billions of years without borders and revolutions. The Intellectual World has already had one foot in the nuclear grave in just a few millennia.\n<br>\n<br>Such a gap in achievements is because <b>NATURE GENERATES EXPERIENCE: from the beginning to the end, everything is for itself</b>. Thanks to which Evolution receives billions of Personal Results for the selection of the Best. Evolution receives nothing from Man, apart from problems. Because <b>MAN REPLIES EXPERIENCE: lives as POWER AUTHORITY commands</b>. And God is not a usurer – He does not need Copies. That's why there is nothing to choose.\n<br>\n<br><b>The INTELLECT became sick with POWER AUTHORITY when it realised that the Privatisation of the Global Right to the Earth would facilitate, accelerate, and increase the Volumes of Profit to limitless amounts.</b> «HAVING MORE THAN I KNOW» to do just by transferring personal rights to collective use turned out to be a very tempting idea for both Thieves and the Righteous. AND IT BEGAN.\n<br>\n<br>Since then, not the PEOPLE, but banal PROFIT, as well as obtaining physical, mental or other BENEFIT, is the only SOURCE of POWER AUTHORITY in particular and of any DOMINATION in general. <b>POWER over ONESELF is HEALTHY, POWER over SOMEONE is a PATHOLOGY. </b>That is why the PEOPLE in this Story are not a pathology and not even a party to an Agreement or Conspiracy, but only an INSTRUMENT OF SOMEONE'S PROFIT.\n<br>\n<br>THE EVOLUTIONARY EQUALITY ORDER, in which only the Result is Private, has been abolished. In its place has been introduced the Humanitarian Order, which has limited Evolutionary Resources to national, religious, state, corporate and, finally, private Boundaries. <b>The deal with the same Devil who lurks behind our every misdemeanour – MENTAL COLLECTIVISM – has been made.\n</b><br>\n<br><b>The victory of all in general is always the defeat of each in particular. </b>Therefore, any collectivism is a suicide of the individual and a crime against Evolution. Because the unification of Man nullifies his evolutionary uniqueness. And the unification of one community in front of another is an inevitable War without any chance of PEACE between GENERATIONS. In fact, we have been living in a war for a long time, simulating peace.\n<br>\n<br><b>Mental COLLECTIVISM – Matrix of the Current World Order.</b> Tactically, it is an Ideological Pyramid with national, political, religious, or state characteristics, the growth in Plus of which is possible only at the expense of someone else’s growth in Minus. Whether it is a Conspiracy or a Contract, all Ideological Pyramids together or individually are doomed to Confrontation, Split and Disintegration in the struggle for Man, because they are not <b>UNCONDITIONAL</b> for him.\n<br>\n<br><b>Only the Entire Planet, not a fragment of it, guarantees SELF-SUFFICIENT LIFE. The SUN, AIR, WATER, EARTH are THE UNCONDITIONAL EVOLUTIONARY RIGHT OF MAN, which cannot be religious, national, political, state, yesterday or tomorrow – like everything TRUE, it must be for EVERYONE, EVERYWHERE and ALWAYS. </b>When an animal owns the world and a HUMAN owns a stub of it, that's Psychiatry.\n<br>\n<br><b>Strategically, Mental COLLECTIVISM is a source of EXCESS of Time and Means. It causes social dependence with the loss of PERSONAL INDEPENDENCE. It is the main factor of HUMANITARIAN INFLATION.</b> And whatever you profess – Fascism, Democracy, Islam or Christianity – by doing so, you propagandise Collectivism, which is a crime against the Personality, monopolised by the State.\n<br>\n<br>Incredibly, the Original Matrix of all Ideologies of the world, and at the same time, with all pathologies that exclude Evolution. Because if EVOLUTION is the achievement of the Unity of Differences, then Man imitates Unity, erasing all Differences, including Sexual. If <b>EVOLUTION is a movement towards the zero edge between Excess and Deficit, which is SELF-SUFFICIENCY</b>, then Man, on the contrary, is eager to drown this Edge in Excess.\n<br>\n<br>Truly an unsurpassed crime and a brilliant example of the Great Lie by Schicklgruber, which over the millennia has turned into an unshakable Truth. And here President Trump is right that Harvard eats bread for nothing, because only a parrot could not understand for centuries that <b>Compromise, Terrorism, Love, Hatred and other forms of humanitarian coexistence are not tools of Self-Sufficiency, but SYMPTOMS OF ITS DEFICIENCY</b>.\n<br>\n<br>But the truth is that it was the USA that first started investing in Scientists, not in Science. That is why meagre North Korea has Hypersonic Missiles, and «Great» America has only a Great Debt, bigger than America itself. <b>Ideological prostration, political hysteria, national and religious psychosis, paranoid mercantilism – this is what the most self-titled Intellect looks like on the global podium today.\n</b><br>\n<br><b>The incessant preaching of Quantitative Growth at the expense of Qualitative Growth has accelerated HUMANITARIAN INFLATION to an “animal” state, in which all Borders, including State Borders, are not Protection, but a Threat. </b>Unlike Quality, Quantity has a Limit beyond which there is an inevitable Deficit of Space, sanitary, economic, etc. Everything that grows to the Borders is destined to burn out in internal, external, or both conflicts at once.\n<br>\n<br><b>Democratic Collectivism has dissolved Personal Self-Sufficiency into Collective Dependence to the point of complete INABILITY.</b> Nevertheless, to survive, the “printing presses” of National, Religious, Political Collectivism ignore the Hyperinflation of Man and for millennia replicate their Enemy – everyone who is superfluous in quantity and unsuitable in quality – condemned to Protest.\n<br>\n<br><b>The World is still shaking from the cries of millions of babies, whose crazy parents give them to be raised in the hands of others. And even animals do not do this. And this is only the first and smallest PROTEST of thousands of conflicts generated by Social Collectivism. </b>Additionally, there are also Religious, Political, National, and Gender Aspects. And finally, their mix – Global Protest, which is practically impossible to absorb and transform.\n<br>\n<br><b>Global DENATIONALIZATION “from below” is clear evidence that this Ouroboros is reaching a critical mass, the ANARCHICAL explosion of which will be received by “Winner”. </b>Technical Progress has outpaced Mental Evolution. Actions precede Decisions. Education does not Develop, but Instils. The efficiency of 30 pieces of silver is not even within the power of billions. A sunflower on the Canvas is more expensive than in the Field. The Mental Maximum of Nations is no higher than the Stomach Maximum.\n<br>\n<br><b>ACQUIRED IDEOLOGICAL DEFICIT SYNDROME (AIDS) – a diagnosis of the 21st-century Man. It arises in the environment of Mental Collectivism. It affects every Consciousness that «HAS MORE THAN IT KNOWS».</b> AIDS leads to the Malignant Monetisation of Relationships: profit becomes corrupt; laws become subjective; intellectual and spiritual evolution becomes futile; peaceful coexistence of worldviews becomes impossible.\n<br>\n<br><b>The main and irreversible complication is Mental Obesity against the background of Spiritual Anorexia. In the Humanitarian Mass, this is the globally dominant Social Class, whose Social Demands are significantly higher than its Personal Productivity.</b> Like all Collectives, it is unable to reproduce mentally. Therefore, it survives by cloning. That destroys its Genetic Experience and makes Evolutionary Growth impossible.\n<br>\n<br><b>The rapid reduction of the distance between “I want” and “I have”, synthesised by Credits and Grants, killed long-term Projects. </b>The mind with neglected Creative Will quickly “got hooked” on social dividends. And now it wants to receive them not only as “possible” and demand them as “due”, but also to take them away as “own”. And in the hands of primates, it is no longer a grenade – a nuclear weapon.\n<br>\n<br><b>With such failures, Evolution does not cure, does not reboot, but RESETS THE SYSTEM to factory settings.</b> Viruses and natural disasters unceremoniously destroy the surplus in Nature. Human Arrogance is curbed by Herd Ideologies – Collectivism. This is how Rome and the USSR fell.  Since Arrogance became global, Collectivism has been replaced by its final stage – GLOBALIZATION. This is how Moscow and Washington, London and Beijing will fall.\n<br>\n<br>And this is not a forecast. This is a reality to which deceived \"shareholders\" return from the \"bright future\" not to receive, but to take away what was promised. <b>This is exactly what the collapse of the World Order looks like: if Person does not take up Reason, the Bolsheviks take up the Revolver. </b>For Collectivism, this is a Catastrophe. For Evolution, it is a Vacancy, and it is currently the top one. That's why there is a holiday in the cemetery of History: when there is no one else to go into the minus, it's the Pyramid's turn.\n<br>\n<br><b>Axiomatic Final is described in the first words of the Bible: “...so God created Man in His own image...”. And then, not a word about Russians, Americans, Muslims, Jews, Democrats, and everyone else for whom being JUST A HUMAN is not enough.</b> The only question is what we will sacrifice to become Human again: ourselves or the necklace?\n<br>\n<br>\n<br>P.S. \n<br>Not Money, not Faith, not Religion, and not even God – <b>the Ticket to NOAH'S ARK is PERSONAL QUALIFICATION only</b>.<br></p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v0FABtkZn7",
          "_anchor": "content5-2g",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".text-wrapper": {
                "padding": "1rem"
              }
            },
            "@media (max-width: 991px)": {
              ".image-wrapper": {
                "margin-bottom": "1rem"
              }
            },
            ".row": {
              "flex-direction": "row-reverse"
            },
            "img": {
              "width": "100%"
            },
            "@media (min-width: 992px)": {
              ".text-wrapper": {
                "padding": "2rem"
              }
            },
            ".mbr-section-title": {
              "color": "#364e6f",
              "text-align": "left"
            },
            ".mbr-description": {
              "color": "#364e6f"
            }
          },
          "_name": "image2",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"image2\" group=\"Images & Videos\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" name=\"textWidth\" title=\"Image\" min=\"4\" max=\"8\" step=\"1\" value=\"4\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDescription\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#bed3f9\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background13.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth}\">\n        <div class=\"row align-items-center\">\n            <div class=\"col-12 col-lg-{{textWidth}}\">\n                <div class=\"image-wrapper\">\n                    <img src=\"@PROJECT_PATH@/assets/images/avtor-815x961.jpg\" alt=\"Mobirise Website Builder\">\n                    <p class=\"mbr-description mbr-fonts-style mt-2 align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showDescription\" data-app-selector=\".mbr-description\">\n                        Access to the Process Formula<br>means control over It.</p>\n                </div>\n            </div>\n            <div class=\"col-12\" mbr-class=\"{'col-lg' : !fullWidth, 'col-lg-4' : fullWidth &amp;&amp; textWidth >= 6, 'col-lg-6' : fullWidth &amp;&amp; textWidth <= 5}\">\n                <div class=\"text-wrapper\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\"><b>ONLY A SHEEP NEEDS A SHEPHERD.&nbsp;</b><b><br></b><b>A PERSON NEEDS A COURSE.</b></h3>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">To know what to do, you need to understand what is happening. In the late 90s, referring to the FORMULA OF HUMANITARIAN PATHOLOGIES, we warned the world elites that <b>the inevitable collapse of Ukraine is a LOCAL SYMPTOM of a GLOBAL DISEASE</b>. And although no one sought satisfaction, today on the Confessional Oder it is no longer Ukraine, but the WORLD ORDER itself.\n<br>\n<br><b>The Evolutionary Equality Centrifuge – GLOBALIZATION – DE FACTO puts an end to the history of Religions, Nations and States that deny each other in particular and Human Evolution in general. </b>Which, in conditions of high demographic density, fierce competition for resources and HYPERTROPHIED DEMAND FOR JUSTICE, dooms them to continuous CONFLICT and SELF-DESTRUCTION.\n<br>\n<br>Globally, the only-begotten essence of the State in particular and Collectivism in general is the CONDITIONS under which ONE receives the Right to dispose of what belongs to ALL. Locally, <b>the New World was the first to break its promise – «HAVING MORE THAN I KNOW» is not enough for everyone OBJECTIVELY</b>. Finding Resources, reducing the Conditions or reducing Everyone are the available ways to solve this problem.\n<br>\n<br>The only trouble is that with such a choice, finding Resources means reducing Everyone. Therefore, in the single effective remainder, either we cancel CONDITIONS, or CONDITIONS cancel US.<b> To stop this SELF-DESTRUCTION, I propose to LEGALIZE GLOBALIZATION DE JURE through IDEOLOGY, which can ABSORB ALL HUMANITARIAN WORLDVIEWS into ONE EVOLUTIONARY ONE.</b> PEACE is when ALL ARE RIGHT or ALL ARE GUILTY.\n<br>\n<br>The UNIPOLAR WORLD IDEOLOGY is the only thing that can bridle MULTIPOLAR BOLSHEVISM with its ESPRIT DE CORPS, which has crushed the SELF-SUFFICIENCY of Man and which today only God is not burdened with. <b>BOLSHEVISM, religious, political or any other, is not an Ideology. BOLSHEVISM IS A VIRUS OF EVOLUTION. It is impossible to overcome it. IT IS ONLY POSSIBLE TO NOT GET SICK OF IT.\n</b><br>\n<br>The SCO's EQUAL GLOBAL GOVERNANCE SYSTEM of September 1, 2025, is not just a declaration of the intentional Old-World Bolshevism transformation from an epidemic into a pandemic. First of all, <b>it is a demonstration of the ideological incapacity of New-World Bolshevism, against the background of which the SCO has only two steps left to take to drive Europe and the USA into their final economic \"quarantine\".</b><br>\n<br>Unfortunately or fortunately, but just like the HUMANITARIAN QUALITY, the political, religious, and economic HYGIENE of BOTH WORLDS is as fake as one of the Snobbery symptoms – the American smile. And <b>where there is pathology, there is a VIRUS. War is not because DECISIONS have ended. War is because MAN has ended. </b>In the meantime, those who wash their hands will die – animals have absolute immunity.\n<br>\n<br>When an animal owns the world and a HUMAN owns a stub of it, that's Psychiatry. <b>Only the Entire Planet, not a fragment of it, guarantees SELF-SUFFICIENT LIFE. The SUN, AIR, WATER, EARTH are THE UNCONDITIONAL EVOLUTIONARY RIGHT OF MAN, which cannot be religious, national, political, state, yesterday or tomorrow – like everything TRUE, it must be for EVERYONE, EVERYWHERE and ALWAYS.\n</b><br>\n<br>A UNIPOLAR WORLD will happen under any circumstances: either thanks to us before the BIG BANG, or after IT, thanks to EVOLUTION – the more Polarities, the more likely a SHORT CIRCUIT. <b>As an alternative to the Bunker, I propose the UNIPOLAR IDEOLOGY MATRIX, which includes: advertising, electoral, legislative and executive strategies; Ideological Fraud Scanner; Personal Formatting Utility</b> (optional)<b>.</b><br>\n<br>The developed IDEOLOGY is capable of replacing any POWER AUTHORITY. But <b>its main purpose is to replace COLLECTIVIZATION with PERSONALIZATION, HUMANITARIAN ORDER with EVOLUTIONARY ORDER, in which everything is determined not by status,&nbsp; flexibility, tolerance or patriotism, but EXCLUSIVELY by QUALIFICATION</b>.<b> </b>This will not solve most problems at once, but will objectively reduce their MULTIPLICITY to ONE.\n<br><br>\n<br>&nbsp; P.S.\n<br>In the GLOBALISATION MILLSTONE, only that State will survive, which the World as a whole will become. As an example, AMERICA WILL BECOME GREAT again only when the WHOLE WORLD BECOMES AMERICA.\n<br>\n<br><i>In reality, the political, humanitarian, economic, and religious exhaustion of Ukraine makes it exactly the most optimal place for the painless <b>INSTALLATION OF AN EVOLUTIONARY ORDER</b>. The realisation of such a Right is the only justification for the price that Ukraine pays in advance in the form of territorial and human losses. Of course, if someone else traditionally does not use this Right.&nbsp;</i><br></p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v0Ke1itQme",
          "_anchor": "image2-2m",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            ".line": {
              "background-color": "@lineColor",
              "align": "center",
              "height": "2px",
              "margin": "0 auto"
            },
            ".mbr-text": {
              "color": "#4d6d9a"
            }
          },
          "_name": "content6",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content6\" group=\"Content\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"10\" step=\"1\">\n        \n        <input type=\"color\" name=\"lineColor\" title=\"Color\" value=\"#6592e6\">\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#ffffff\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-md-12 col-lg-{{textWidth}}\">\n                <hr class=\"line\">\n                <p class=\"mbr-text align-center mbr-fonts-style my-4\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\"><b>THERE ARE NO ONES WHO ARE AHEAD. THERE ARE ONLY THOSE WHO ARE LATE.</b></p>\n                <hr class=\"line\">\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v0FqzrSofw",
          "_anchor": "content6-2d",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        }
      ]
    },
    "UA.html": {
      "settings": {
        "title": "UA",
        "meta_descr": "The World Order Matrix",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "order": "1"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@sticky)": {
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "& when (@sticky)": {
              "z-index": "1000",
              "width": "100%",
              "& when not (@transparent)": {
                "position": "relative",
                "min-height": "60px"
              },
              "nav.navbar": {
                "position": "fixed"
              }
            },
            ".dropdown-item:before": {
              "font-family": "Moririse2 !important",
              "content": "\"\\e966\"",
              "display": "inline-block",
              "width": "0",
              "position": "absolute",
              "left": "1rem",
              "top": "0.5rem",
              "margin-right": "0.5rem",
              "line-height": "1",
              "font-size": "inherit",
              "vertical-align": "middle",
              "text-align": "center",
              "overflow": "hidden",
              "transform": "scale(0, 1)",
              "transition": "all 0.25s ease-in-out"
            },
            ".dropdown-menu": {
              "padding": "0",
              "border-radius": "4px",
              "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)"
            },
            ".dropdown-item": {
              "border-bottom": "1px solid #e6e6e6",
              "&:hover, &:focus": {
                "background": "@primaryColor !important",
                "color": "white !important"
              },
              "&:hover span": {
                "color": "white"
              },
              "&:first-child": {
                "border-top-left-radius": "4px",
                "border-top-right-radius": "4px"
              },
              "&:last-child": {
                "border-bottom": "none",
                "border-bottom-left-radius": "4px",
                "border-bottom-right-radius": "4px"
              }
            },
            ".nav-dropdown .link": {
              "padding": "0 0.3em !important",
              "margin": "0.667em 1em !important"
            },
            ".nav-dropdown .link.dropdown-toggle::after": {
              "margin-left": "0.5rem",
              "margin-top": "0.2rem"
            },
            ".nav-link": {
              "position": "relative"
            },
            ".container": {
              "display": "flex",
              "margin": "auto",
              "& when not (@collapsed)": {
                "@media (min-width: 992px)": {
                  "flex-wrap": "nowrap"
                }
              }
            },
            ".iconfont-wrapper": {
              "color": "@iconsColor !important",
              "font-size": "1.5rem",
              "padding-right": "0.5rem"
            },
            ".navbar-caption": {},
            ".navbar-nav": {},
            ".dropdown-menu, .navbar.opened": {
              "background": "@menuBgColor !important"
            },
            ".nav-item:focus, .nav-link:focus": {
              "outline": "none"
            },
            ".dropdown .dropdown-menu .dropdown-item": {
              "width": "auto",
              "transition": "all 0.25s ease-in-out",
              "&::after": {
                "right": "0.5rem"
              },
              ".mbr-iconfont": {
                "margin-right": "0.5rem",
                "vertical-align": "sub",
                "&:before": {
                  "display": "inline-block",
                  "transform": "scale(1, 1)",
                  "transition": "all 0.25s ease-in-out"
                }
              }
            },
            ".collapsed": {
              ".dropdown-menu .dropdown-item:before": {
                "display": "none"
              },
              ".dropdown .dropdown-menu .dropdown-item": {
                "padding": "0.235em 1.5em 0.235em 1.5em !important",
                "transition": "none",
                "margin": "0 !important"
              }
            },
            ".navbar": {
              "min-height": "70px",
              "transition": "all 0.3s",
              "border-bottom": "1px solid transparent",
              "&:not(.navbar-short)": {},
              "& when not (@transparent)": {
                "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)",
                "background": "@menuBgColor"
              },
              "& when (@transparent)": {
                "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity)"
              },
              "&.opened": {
                "transition": "all 0.3s"
              },
              ".dropdown-item": {
                "padding": "0.5rem 1.8rem"
              },
              ".navbar-logo img": {
                "width": "auto"
              },
              ".navbar-collapse": {
                "justify-content": "flex-end",
                "z-index": "1"
              },
              "&.collapsed": {
                "justify-content": "center",
                ".nav-item .nav-link::before": {
                  "display": "none"
                },
                "&.opened": {
                  ".dropdown-menu": {
                    "top": "0"
                  },
                  "@media (min-width: 992px)": {
                    "&:not(.navbar-short) .navbar-collapse when (@showLogo)": {
                      "max-height": "~\"calc(98.5vh - @{logoSize}rem)\""
                    }
                  }
                },
                ".dropdown-menu": {
                  ".dropdown-submenu": {
                    "left": "0 !important"
                  },
                  ".dropdown-item:after": {
                    "right": "auto"
                  },
                  ".dropdown-toggle[data-toggle=\"dropdown-submenu\"]:after": {
                    "margin-left": "0.5rem",
                    "margin-top": "0.2rem",
                    "border-top": "0.35em solid",
                    "border-right": "0.35em solid transparent",
                    "border-left": "0.35em solid transparent",
                    "border-bottom": "0",
                    "top": "41%"
                  }
                },
                "ul.navbar-nav": {
                  "li": {
                    "margin": "auto"
                  }
                },
                ".dropdown-menu .dropdown-item": {
                  "padding": "0.25rem 1.5rem",
                  "text-align": "center"
                },
                ".icons-menu": {
                  "padding-left": "0",
                  "padding-right": "0",
                  "padding-top": "0.5rem",
                  "padding-bottom": "0.5rem"
                }
              },
              "@media (max-width: 991px)": {
                ".nav-item .nav-link::before": {
                  "display": "none"
                },
                "&.opened": {
                  ".dropdown-menu": {
                    "top": "0"
                  }
                },
                ".dropdown-menu": {
                  ".dropdown-submenu": {
                    "left": "0 !important"
                  },
                  ".dropdown-item:after": {
                    "right": "auto"
                  },
                  ".dropdown-toggle[data-toggle=\"dropdown-submenu\"]:after": {
                    "margin-left": "0.5rem",
                    "margin-top": "0.2rem",
                    "border-top": "0.35em solid",
                    "border-right": "0.35em solid transparent",
                    "border-left": "0.35em solid transparent",
                    "border-bottom": "0",
                    "top": "40%"
                  }
                },
                ".navbar-logo": {
                  "img": {
                    "height": "3rem !important"
                  }
                },
                "ul.navbar-nav": {
                  "li": {
                    "margin": "auto"
                  }
                },
                ".dropdown-menu .dropdown-item": {
                  "padding": "0.25rem 1.5rem !important",
                  "text-align": "center"
                },
                ".navbar-brand": {
                  "flex-shrink": "initial",
                  "flex-basis": "auto",
                  "word-break": "break-word",
                  "padding-right": "2rem",
                  "@media (max-width: 767px)": {
                    "width": "~\"calc(100% - 31px)\""
                  }
                },
                ".navbar-toggler": {
                  "flex-basis": "auto"
                },
                ".icons-menu": {
                  "padding-left": "0",
                  "padding-top": "0.5rem",
                  "padding-bottom": "0.5rem"
                }
              },
              "&.navbar-short": {
                "min-height": "60px",
                ".navbar-logo": {
                  "img": {
                    "height": "2.5rem !important"
                  }
                },
                ".navbar-brand": {
                  "min-height": "60px",
                  "padding": "0"
                }
              }
            },
            ".navbar-brand": {
              "min-height": "70px",
              "flex-shrink": "0",
              "align-items": "center",
              "margin-right": "0",
              "padding": "10px 0",
              "transition": "all 0.3s",
              "word-break": "break-word",
              "z-index": "1",
              ".navbar-caption": {
                "line-height": "inherit !important"
              },
              ".navbar-logo a": {
                "outline": "none"
              }
            },
            ".dropdown-item.active, .dropdown-item:active": {
              "background-color": "transparent"
            },
            ".navbar-expand-lg .navbar-nav .nav-link": {
              "padding": "0"
            },
            ".nav-dropdown .link.dropdown-toggle": {
              "margin-right": "1.667em",
              "&[aria-expanded=\"true\"]": {
                "margin-right": "0",
                "padding": "0.667em 1.667em"
              }
            },
            ".navbar.navbar-expand-lg .dropdown": {
              ".dropdown-menu": {
                "background": "@menuBgColor",
                ".dropdown-submenu": {
                  "margin": "0",
                  "left": "100%"
                }
              }
            },
            ".navbar .dropdown.open > .dropdown-menu": {
              "display": "block"
            },
            "ul.navbar-nav": {
              "flex-wrap": "wrap"
            },
            ".navbar-buttons": {
              "text-align": "center",
              "min-width": "170px"
            },
            "button.navbar-toggler": {
              "outline": "none",
              "width": "31px",
              "height": "20px",
              "cursor": "pointer",
              "transition": "all 0.2s",
              "position": "relative",
              "align-self": "center",
              ".hamburger span": {
                "position": "absolute",
                "right": "0",
                "width": "30px",
                "height": "2px",
                "border-right": "5px",
                "background-color": "@hamburgerColor",
                "&:nth-child(1)": {
                  "top": "0",
                  "transition": "all 0.2s"
                },
                "&:nth-child(2)": {
                  "top": "8px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(3)": {
                  "top": "8px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(4)": {
                  "top": "16px",
                  "transition": "all 0.2s"
                }
              }
            },
            "nav.opened .hamburger span": {
              "&:nth-child(1)": {
                "top": "8px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              },
              "&:nth-child(2)": {
                "transform": "rotate(45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(3)": {
                "transform": "rotate(-45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(4)": {
                "top": "8px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              }
            },
            ".navbar-dropdown": {
              "padding": "0 1rem",
              "& when (@sticky)": {
                "position": "fixed"
              }
            },
            "a.nav-link": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center"
            },
            ".icons-menu": {
              "flex-wrap": "nowrap",
              "display": "flex",
              "justify-content": "center",
              "padding-left": "1rem",
              "padding-right": "1rem",
              "padding-top": "0.3rem",
              "text-align": "center"
            },
            "@media screen and (~'-ms-high-contrast: active'), (~'-ms-high-contrast: none')": {
              ".navbar": {
                "height": "70px",
                "&.opened": {
                  "height": "auto"
                }
              },
              ".nav-item .nav-link:hover::before": {
                "width": "175%",
                "max-width": "calc(100% ~\"+\" 2rem)",
                "left": "-1rem"
              }
            }
          },
          "_name": "menu1",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu1\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\">\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"3\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\" checked>\n        <input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\">\n        <select title=\"Amount\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#000000\" condition=\"showIcons\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\">\n        <header>Styles</header>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"transparent\">\n        <input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#4d6d9a\">\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#232323\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                     'navbar-expand-lg':!collapsed,\n                     'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n            <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"https://mobiri.se\">\n                        <img src=\"../_images/logo.png\" alt=\"Mobirise Website Builder\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-white\" data-app-selector=\".navbar-caption\" href=\"index.html#top\" data-app-placeholder=\"Type Text\">AXICORR</a></span>\n            </div>\n            <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showIcons || showButtons\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\"><a class=\"nav-link link text-white text-primary\" href=\"index.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">EN</a></li>\n                    <li class=\"nav-item\"><a class=\"nav-link link text-white\" href=\"UA.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">UA</a></li>\n                    <li class=\"nav-item\"><a class=\"nav-link link text-white\" href=\"RU.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">RU</a>\n                    </li></ul>\n                <div class=\"icons-menu\" mbr-if=\"showIcons\">\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-facebook socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 1\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-twitter socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 2\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-instagram socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 3\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-linkedin socicon\"></span>\n                    </a>\n                </div>\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\">\n                    <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                        Download Now</a>\n                </div>\n            </div>\n        </div>\n    </nav>\n</section>",
          "_cid": "v0JEMumWWB",
          "_anchor": "menu1-2h",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".social-row": {
              ".soc-item": {
                "display": "inline-block",
                "text-align": "center",
                "margin-bottom": "1rem",
                "margin-right": ".7rem",
                ".mbr-iconfont": {
                  "font-size": "32px",
                  "border-radius": "50%",
                  "padding": "0.6rem",
                  "border": "2px solid @socialIconColor",
                  "transition": "all 0.3s",
                  "color": "@socialIconColor",
                  "&:hover": {
                    "background-color": "@socialIconColor",
                    "color": "contrast(@socialIconColor)"
                  }
                }
              }
            }
          },
          "_name": "header13",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header13\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n\n        <input type=\"range\" inline name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"10\" step=\"1\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value>Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\">\n        <input type=\"range\" name=\"socialCount\" title=\"Count\" min=\"1\" max=\"5\" step=\"1\" value=\"3\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Color\" name=\"socialIconColor\" value=\"#232323\" condition=\"showSocial\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/mbr-1-1920x1280.jpg\" parallax selected>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background13.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#bed3f9\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"align-center\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row {{contentAlign}}\">\n            <div class=\"col-12 col-lg-{{textWidth}}\">\n                <h1 class=\"mbr-section-title mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>ЛЮДИНА проти ЕВОЛЮЦІЇ</b></h1>\n                <h2 class=\"mbr-section-subtitle mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-2\" mbr-if=\"showSubitle\">спроба 2025-а</h2>\n                <p class=\"mbr-text mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn, .social-row\"><br>ONLY SHEEP NEED A SHEPHERD. A PERSON NEEDS A COURSE.</p>\n                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn mt-3\" mbr-if=\"showButtons\"><a class=\"btn btn-primary\" href=\"index.html\" data-app-placeholder=\"Type Text\">EN</a> <a class=\"btn btn-primary\" href=\"mailto:axicorrman@gmail.com\" data-app-placeholder=\"Type Text\">MAIL</a> <a class=\"btn btn-primary\" href=\"RU.html\" data-app-placeholder=\"Type Text\">RU</a></div>\n                <div class=\"social-row display-7 mt-5\" mbr-if=\"showSocial\">\n                    <div class=\"soc-item\">\n                        <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont socicon socicon-facebook\"></span>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"socialCount>1\">\n                        <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont socicon socicon-twitter\"></span>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"socialCount>2\">\n                        <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"socialCount>3\">\n                        <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont socicon socicon-youtube\"></span>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"socialCount>4\">\n                        <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont socicon socicon-telegram\"></span>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uQPq3jmxmh",
          "_anchor": "header13-1h",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            ".line": {
              "background-color": "@lineColor",
              "align": "center",
              "height": "2px",
              "margin": "0 auto"
            },
            ".mbr-text": {
              "color": "#364e6f"
            }
          },
          "_name": "content6",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content6\" group=\"Content\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"10\" step=\"1\">\n        \n        <input type=\"color\" name=\"lineColor\" title=\"Color\" value=\"#6592e6\">\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#ffffff\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-md-12 col-lg-{{textWidth}}\">\n                <hr class=\"line\">\n                <p class=\"mbr-text align-center mbr-fonts-style my-4\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\"><b>УКРАЇНА здатна на все, окрім головного – вона не здатна ЕВОЛЮЦІОНУВАТИ.\n<br></b>Імпорт ідеологічної сировини в ній складає 100%, жоден з яких ніколи й ніким не перевірявся на Шахрайство. Від чого «столиця» українців завжди за кордоном. Тим не менше все, що коїться з нами зараз – історія вже не про Україну. Це історія про СВІТОПОРЯДОК, який так довго всіх обдурював, що врешті-решт обдурив сам себе.<br></p>\n                <hr class=\"line\">\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v0KbFpIvcS",
          "_anchor": "content6-2i",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor"
          },
          "_name": "content5",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content5\" group=\"Content\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"10\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#ffffff\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-md-12 col-lg-{{textWidth}}\">\n                <h3 class=\"mbr-section-title mbr-fonts-style mb-4\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\">\n                    <b>Article Title</b>\n                </h3>\n                <h4 class=\"mbr-section-subtitle mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\">\n                    Enter your subtitle here\n                </h4>\n                <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\"><b>МАКСИМАЛЬНИЙ РЕЗУЛЬТАТ за МІНІМАЛЬНИХ ЗУСИЛЬ: від Злодія й до Бога – всі живуть за цією формулою, бо це ФОРМУЛА ЕВОЛЮЦІЇ.</b> Різниця лише в тому, що Доінтелектуальний Світ без границь й революцій живе мільярди років. А Світ Інтелекту за кілька тисячоліть однією ногою вже встиг побувати в ядерній могилі.\n<br>\n<br>Така прірва в досягненнях від того, що <b>ПРИРОДА ГЕНЕРУЄ ДОСВІД: від початку і до кінця всяк сам за себе</b>. Завдяки чому Еволюція отримує мільярди Персональних результатів для відбору Кращого. Від Людини ж, окрім проблем, Еволюція не отримує нічого. Бо <b>ЛЮДИНА ТИРАЖУЄ ДОСВІД: живе як ВЛАДА велить</b>. А Бог не лихвар – йому Копії не потрібні. Тому й відбирати нічого.\n<br>\n<br><b>ІНТЕЛЕКТ захворів ВЛАДОЮ, коли усвідомив, що Приватизація Глобального Права на Землю: Полегшить, Прискорить й Збільшить Об’єми Прибутку до безмежних величин. </b>«МАТИ БІЛЬШЕ, АНІЖ ВМІЄШ» лише за рахунок передачі Персональних Прав в Колективне Користування, виявилося надто спокусливою ідеєю як для Злодіїв, так і для Праведників. Й ПОЧАЛОСЯ.\n<br>\n<br>Відтоді не НАРОД, а банальний ПРИБУТОК, як і отримання фізичної, ментальної чи іншої ВИГОДИ, є єдинородним ДЖЕРЕЛОМ ВЛАДИ зокрема й будь-якого ДОМІНУВАННЯ взагалі.<b> ЗДОРОВОЮ є ВЛАДА над СОБОЮ, ВЛАДА ж над КИМОСЬ – ПАТОЛОГІЯ.</b> Від чого НАРОД в цій Історії – не патологія й навіть не сторона Угоди чи Зговору, а – лише ІНСТРУМЕНТ ЧИЙОГОСЬ ПРИБУТКУ.\n<br>\n<br>ПОРЯДОК ЕВОЛЮЦІЙНОЇ РІВНОСТІ, в якому Приватним є лише Результат, було скасовано. Йому на зміну запроваджено Порядок Гуманітарний, який обмежив Еволюційні Ресурси національними, релігійними, державними, корпоративними й, нарешті, приватними Границями. <b>Угода з тим самим Чортом, який маячить за кожним нашим Проступком – МЕНТАЛЬНИМ КОЛЕКТИВІЗМОМ – відбулася.\n</b><br>\n<br><b>Перемога всіх загалом – це завжди поразка кожного зокрема.</b> Тому будь-який колективізм – це суїцид особистості і злочин проти Еволюції. Бо уніфікація Людини зводить нанівець її еволюційну неповторність. А уніфікація однієї спільноти на очах у іншої – це неминуча Війна без жодних шансів на МИР між ПОКОЛІННЯМИ. Насправді ж, ми давно живемо війною, симулюючи мир.\n<br>\n<br><b>МЕНТАЛЬНИЙ КОЛЕКТИВІЗМ – Матриця Діючого Світопорядку. </b>Тактично, це Ідеологічна Піраміда з національними, політичними, релігійними, чи державними ознаками, ріст в Плюс якої можливий лише за рахунок чийогось росту в Мінус. Зговір це чи Договір, всі Ідеологічні Піраміди вкупі чи поодинці приречені на Протистояння, Розкол й Розпад в боротьбі за Людину, бо не є <b>БЕЗУМОВНИМИ</b> для неї.\n<br>\n<br><b>САМОДОСТАТНЄ ЖИТТЯ гарантує вся Планета, а не її фрагмент. СОНЦЕ, ПОВІТРЯ, ВОДА, ЗЕМЛЯ – БЕЗУМОВНЕ ЕВОЛЮЦІЙНЕ ПРАВО Людини, яке не може бути релігійним, національним, політичним, державним, вчора чи завтра – як і все Істинне Воно має бути у ВСІХ, ВСЮДИ й ЗАВЖДИ. </b>Коли ж тварина володіє Світом, а Людина лише Його огризком – це Діагноз.\n<br>\n<br><b>Стратегічно, Ментальний КОЛЕКТИВІЗМ – джерело НАДЛИШКУ Часу й Засобів. Викликає соціальну залежність з втратою ПЕРСОНАЛЬНОЇ САМОДОСТАТНОСТІ. Є головним чинником ГУМАНІТАРНОЇ ІНФЛЯЦІЇ. </b>Й що б Ви не сповідували – Фашизм, Демократію, Іслам чи Християнство – цим Ви пропагуєте Колективізм, який є злочином проти Особистості, монополізований Державою.\n<br>\n<br>Неймовірно, вихідна Матриця всіх Ідеологій світу й одразу зі всіма патологіями, які виключають Еволюцію. Бо якщо ЕВОЛЮЦІЯ – це досягнення Єдності Різностей, то Людина імітує Єдність, стираючи всяку Різність, включаючи Статеву. Якщо <b>ЕВОЛЮЦІЯ – це рух до нульової грані між ЛИШКОМ ТА ДЕФІЦИТОМ, що і є САМОДОСТАТНІСТЬ</b>, то Людина ж – навпаки – прагне втопити цю Грань в Надлишку.\n<br>\n<br>Воістину неперевершений злочин та геніальний зразок Великої Брехні по Шикльгруберу, яка через тисячоліття перетворилась в непохитну Правду. І тут Президент Трамп правий, що Гарвард їсть хліб дарма. Бо лише папуга віками не може збагнути, що <b>Компроміс, Тероризм, Любов, Ненависть та інші форми гуманітарного співжиття – не інструменти Самодостатності, а СИМПТОМИ ЇЇ ДЕФІЦИТУ</b>.\n<br>\n<br>Але вся правда в тому, що саме США першими почали вкладати гроші у Вчених, а не в Науку. Тому мізерна Північна Корея має Гіперзвук, а «Велика» Америка має лише Великий Борг, більший за саму Америку. <b>Ідеологічна прострація, політична істерія, національні та релігійні психози, параноїдальний меркантилізм – так сьогодні виглядає найтитулованіший собою ж Інтелект на глобальному подіумі.\n</b><br>\n<br><b>Безупинна проповідь Кількісного Росту за рахунок Росту Якісного, розігнала Гуманітарну Інфляцію до «тваринного» стану, в якому всі Границі, включаючи Державні – не Захист, а Загроза. </b>На відміну від Якості, Кількість має Межу, за якою неминучий Дефіцит Простору санітарного, економічного. Всьому, що виростає до Границь, призначено згоріти у внутрішньому, зовнішньому чи в обох конфліктах одразу.\n<br>\n<br><b>Демократичний Колективізм розчинив ПЕРСОНАЛЬНУ САМОДОСТАТНІСТЬ в Колективній Залежності до повної НЕДІЄЗДАТНОСТІ. </b>Тим не менше, аби вижити, «друкарські верстати» Національного, Релігійного, Політичного Колективізму ігнорують Гіперінфляцію Людини й тисячоліттями тиражують власного Ворога: всяк зайвий Кількісно й непридатний Якісно – засуджений на Протест.\n<br>\n<br><b>Й досі здригається Світ від плачу мільйонів немовлят, яких очманілі батьки віддають на виховання в чужі руки. А такого не роблять навіть звірі. Й це лише перший і найменший ПРОТЕСТ з тисяч конфліктів, генерованих Соціальним Колективізмом.</b> А ще є Релігійний, Політичний, Національний, Гендерний. Ну й нарешті їх мікс – Протест Глобальний, поглинути й трансформувати який – практично неможливо.\n<br>\n<br><b>Глобальне РОЗДЕРЖАВЛЕННЯ «знизу» – яскраве свідоцтво того, що цей Уроборос сягає критичної маси, АНАРХІЧНИЙ ВИБУХ якої й отримає «Переможець».</b> Технічний Прогрес випередив Ментальну Еволюцію. Дії передують Рішенням.  Освіта не Розвиває, а Прививає. ККД 30 срібняків не під силу навіть мільярдам. Соняшник на Полотні дорожче, як в Полі. Ментальний Максимум Націй не вище Шлункового.\n<br>\n<br><b>СИНДРОМ НАБУТОГО ІДЕОЛОГІЧНОГО ДЕФІЦИТУ (СНІД) – діагноз Людини 21 століття. Виникає в середовищі Ментального Колективізму. Вражає кожну Свідомість, яка МАЄ БІЛЬШЕ, АНІЖ ВМІЄ.</b> Приводить до Злоякісної Монетизації Відносин: прибуток стає корумпованим; закони – суб’єктивними; інтелектуально-духовна еволюція – марною; мирне співіснування світоглядів – неможливим.\n<br>\n<br><b>Головне й незворотне Ускладнення – Ментальне Ожиріння на фоні Духовної Анорексії. В Гуманітарній Масі це глобально-домінуючий Соціальний Клас, суспільні запити якого значно вищі від його Персональної Продуктивності. </b>Як і все Колективне, ментально розмножуватися не здатен, тому виживає клонуванням, що руйнує Його Генетичний Досвід та унеможливлює Еволюційний Ріст.\n<br>\n<br><b>Стрімке скорочення відстані між «хочу» і «маю», синтезованої  легкими Кредитами, вбило довготермінові Проекти. </b>Розум з занедбаною Творчою Волею швидко «підсів» на соціальні дивіденди. Й тепер бажає отримувати їх не тільки як «можливе» й вимагати як «належне», але й відіймати як «власне». А в руках приматів вже не граната – ядерна зброя.\n<br>\n<br><b>За таких збоїв Еволюція не лікує, не перезавантажує, а СКИДАЄ СИСТЕМУ до заводських налаштувань. </b>Зайве в Природі обнуляють віруси й стихійні лиха. Нахабство Людини розчиняють Стадні Ідеології – Колективізм. Так впали Рим й СРСР.  Відколи Нахабство стало глобальним, на зміну Колективізму прийшла його фінальна стадія – ГЛОБАЛІЗАЦІЯ. Так впадуть Москва, Лондон, Берлін, Пекін й Вашингтон.\n<br>\n<br>І це не прогноз. Це реальність, в яку зі «світлого майбутнього» повертаються обдурені «пайовики» аби не отримати, а забрати обіцяне. <b>В цьому і є крах Світопорядку: якщо Людина не береться за Розум, Більшовики беруться за Револьвер.</b> Для Колективістів це – Катастрофа. Для Еволюції – Вакансія. Й на разі вона топова. Від чого на кладовищі Історії свято: коли в мінус йти більше нікому, настає черга Піраміди.\n<br>\n<br><b>Аксіоматичний Фінал описаний в перших словах Біблії: «…і створив Бог Людину на Свій образ…». А далі, далі ні слова про росіян, американців, мусульман, іудеїв, демократів й всієї решти, якій МАЛО бути просто ЛЮДИНОЮ.</b> Питання лише в тому, чим ми пожертвуємо аби знову стати Людиною: собою чи намистом?\n<br>\n<br><br>&nbsp; P.S.\n<br>Не Гроші, на Віра, не Релігія й навіть не Бог – <b>квиток на НОЇВ КОВЧЕГ – ПЕРСОНАЛЬНА КВАЛІФІКАЦІЯ лише</b>!<br></p>\n            </div>\n        </div>\n    </div>\n</section>",
